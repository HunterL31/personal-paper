# Personal Paper — container variables.
#
# Credentials and infrastructure only; everything the reader changes lives
# in /data/settings.json and is edited from the web page.
# Copy to .env and fill in. Never commit .env.

# Password for the web page (any username). Optional: leave it empty and
# the page has no login, so anyone on your network can open it.
WEB_PASSWORD=

# Bearer token the iPhone Shortcut sends to POST /lists/<slug>. Optional;
# each list also accepts its own slug as the bearer token, and with this
# empty a post with no Authorization header at all is accepted too.
TASKS_TOKEN=

# Outgoing mail for the email route and for failure notifications.
# A Gmail app password works (Google account -> Security -> App passwords).
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Only needed if a paid Substack has to be read from email instead of RSS.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# Mailbox/label the Substack emails land in (default INBOX)
IMAP_MAILBOX=INBOX

# NYT-S cookie from nytimes.com (Developer tools -> Application -> Cookies).
# Needs a Games subscription. Valid about a year. Leave empty and the paper
# simply prints without a crossword.
NYT_S=

# Timezone for the schedule, the calendar window and the weather.
TZ=America/Los_Angeles

# Advanced. The image already sets DATA_DIR=/data (settings, state, logs,
# archive) and Playwright's image already holds Chromium, so CHROMIUM_PATH
# is only for pointing the renderer at a different browser binary.
# DATA_DIR=/data
# CHROMIUM_PATH=
# SETTINGS_PATH=/data/settings.json
